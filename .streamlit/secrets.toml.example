# 啟用 Google Drive 串接時,複製為 secrets.toml 並填入(此檔不會進 git)
# 評核資料備份到 Google 試算表(每個分隊一個分頁);不設定就只存本機 SQLite
BACKUP_SHEET_ID = "請貼上備份試算表的 ID"
DRIVE_ROOT_FOLDER_ID = "縣局根資料夾的 ID(網址 /folders/ 後面那串)"

[GOOGLE_SERVICE_ACCOUNT]
# 貼上服務帳戶金鑰 JSON 的各欄位
type = "service_account"
project_id = ""
private_key_id = ""
private_key = ""
client_email = ""
client_id = ""
token_uri = "https://oauth2.googleapis.com/token"

# 與義消專長資料庫共用帳號(讀取「系統帳號備份」分頁)
ACCOUNT_SHEET_ID = "10OtwasV_4b5PDNgZQJM8pJ0Bhz8yh9jueDE97RFUWF0"
# 用 tools/detect_hash.py 測出來的雜湊方式名稱
ACCOUNT_HASH_SCHEME = "pbkdf2_sha256_260000_bytes"  # 已實測,可省略
